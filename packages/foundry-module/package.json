{
  "name": "@foundry-mcp/module",
  "version": "0.8.0",
  "description": "Warhammer Fantasy Roleplay 4e MCP bridge module for Foundry VTT",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && esbuild src/main.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/main.js --sourcemap && node scripts/verify-browser-safe.mjs",
    "dev": "esbuild src/main.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/main.js --sourcemap --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "socket.io-client": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "@league-of-foundry-developers/foundry-vtt-types": "^9.280.0",
    "@vitest/coverage-v8": "^3.2.4",
    "happy-dom": "^15.0.0",
    "vitest": "^3.2.4"
  },
  "files": [
    "dist",
    "module.json",
    "lang",
    "styles",
    "templates",
    "generated-maps"
  ]
}